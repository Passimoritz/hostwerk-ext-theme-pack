{
  "$schema": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "id": "theme-pack",
  "name": {
    "de": "Farbschemata",
    "en": "Themes"
  },
  "description": {
    "de": "Drei sorgfältig abgestimmte Farbschemata für Hostwerk – „Hoher Kontrast“ für schwächere Augen, „Ruhig“ und „Warm“, jeweils hell und dunkel und auf gute Lesbarkeit geprüft.",
    "en": "Three carefully tuned themes for Hostwerk – “High contrast” for weaker eyesight, “Calm” and “Warm”, each in light and dark and checked for good readability."
  },
  "version": "1.0.1",
  "author": "Hostwerk",
  "homepage": "https://github.com/Passimoritz/hostwerk-ext-theme-pack",
  "license": "MIT",
  "icon": "icon.svg",
  "banner": "banner.svg",
  "color": "#7c4dcc",
  "category": "other",
  "hostwerk": ">=2.11.0",
  "permissions": [],
  "contributes": {
    "themes": [
      {
        "id": "high-contrast",
        "title": {
          "de": "Hoher Kontrast",
          "en": "High contrast"
        },
        "description": {
          "de": "Für schwächere Augen: reines Schwarz und Weiß, kräftige Zustandsfarben, deutliche Linien – Text mindestens 7:1.",
          "en": "For weaker eyesight: pure black and white, strong status colours, clear lines – text at least 7:1."
        },
